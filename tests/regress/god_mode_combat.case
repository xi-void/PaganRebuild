# A changeling's blows deal no damage with God Mode on. The Avatar can
# still kill it. Switching back off makes the next lethal hit fatal.
args: --cheat --map 39 --pos 16454,13798,48
do: t10;look:1;t10;answer:13;answer:14;t5
do: spawn:357,120;t90;vitals;fightstate:@
do: strike:@;strike:@;strike:@;strike:@;strike:@;strike:@;strike:@;strike:@;fightstate:@
do: look:1;t10;answer:13;answer:14;t5;worldhit:1,255;t130
expect: "God Mode: OFF", "Done"]
expect: "God Mode: ON", "Done"]
expect: vitals: hp 30/30
expect: target 1 in_combat true
expect: target 1 in_combat false hp 0
expect: the Avatar is dead
